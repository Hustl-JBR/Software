{
  "name": "project-atlas",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "lint": "pnpm --filter @atlas/web lint",
    "typecheck": "pnpm --filter @atlas/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "zod": "^3.25.76"
  }
}
